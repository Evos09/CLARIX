// CLARIX — Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id         String   @id @default(cuid())
  clerkOrgId String   @unique
  name       String
  plan       Plan     @default(FREE)
  verticals  String[] @default([]) // ["HEALTHCARE","LEGAL","FINANCIAL"]
  useCase    String? // primary use case picked at onboarding
  stripeId   String?
  createdAt  DateTime @default(now())
  customVocabulary String[] @default([])

  users              User[]
  meetings           Meeting[]
  templates          OutputTemplate[]
  actionItems        ActionItem[]
  globalChatSessions GlobalChatSession[]
}

model User {
  id      String       @id @default(cuid())
  clerkId String       @unique
  email   String
  name    String?
  role    Role         @default(MEMBER)
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  meetings            Meeting[]
  globalChatSessions  GlobalChatSession[]
  chatUsage           ChatUsage?
  annotations         ChatAnnotation[]
  emailConnection     EmailConnection?
  emailDigestSettings EmailDigestSettings?
  calendarConnection  CalendarConnection?
  calendarEvents      CalendarEvent[]
  crmconnection       CRMConnection?
  slackConnection     SlackConnection?
  notionConnection    NotionConnection?
  linearConnection    LinearConnection?

  @@index([orgId])
}

model Meeting {
  id                 String        @id @default(cuid())
  title              String
  shareToken         String?       @unique
  audioUrl           String?
  storagePath        String? // path within the storage bucket
  transcriptJobId    String? // AssemblyAI transcript id (webhook correlation)
  rawTranscript      String?
  structuredOutput   Json?
  transcriptSegments Json?
  keyPoints          Json?
  speakerMap         Json?
  audioFilename      String?
  audioSize          Int?
  audioDuration      Int?
  audioMimeType      String?
  processingCount    Int           @default(1)
  meetingType        String        @default("GENERAL")
  detectedType       String?
  autoDetect         Boolean       @default(false)
  consentAcknowledged   Boolean   @default(false)
  consentAcknowledgedAt DateTime?
  status             MeetingStatus @default(UPLOADING)
  duration           Int?
  speakerCount       Int?
  language           String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  tags              Tag[]
  exports           Export[]
  comments          Comment[]
  messages          ChatMessage[]
  actionItemRecords ActionItem[]
  chatAnnotations   ChatAnnotation[]
  emailSends        EmailSend[]
  calendarEvents    CalendarEvent[]
  meetingBot        MeetingBot?
  crmsyncs          CRMSync[]
  meetingAnalytics  MeetingAnalytics?
  integrationPushes IntegrationPush[]
  memoryChunks      MeetingChunk[]
  collaborators     MeetingCollaborator[]

  @@index([orgId])
  @@index([userId])
  @@index([status])
}

// Per-meeting sharing: lets an owner grant another CLARIX user access to a
// single meeting (transcript, summary, action items, chat — everything hangs
// off meetingId) across org boundaries. EDITOR = shared edit access
// (last-write-wins), VIEWER = read-only. Access is resolved in
// lib/meetingAccess.ts (owner org OR a collaborator row here).
model MeetingCollaborator {
  id        String     @id @default(cuid())
  meetingId String
  meeting   Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String // the invited CLARIX user's User.id
  role      CollabRole @default(EDITOR)
  invitedBy String // User.id of the owner who added them
  createdAt DateTime   @default(now())

  @@unique([meetingId, userId])
  @@index([userId])
  @@index([meetingId])
}

enum CollabRole {
  VIEWER
  EDITOR
}

// Semantic-search chunks for cross-meeting memory. `embedding` is a pgvector
// column (OpenAI text-embedding-3-small = 1536 dims); Prisma can't type it, so
// writes go through raw SQL (see lib/memory/ingest.ts) and similarity queries
// use the `<=>` cosine operator (see lib/memory/search.ts). Requires the
// pgvector extension + an HNSW index — see prisma/sql/memory-setup.sql.
model MeetingChunk {
  id        String                       @id @default(cuid())
  meetingId String
  meeting   Meeting                      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  orgId     String
  content   String                       @db.Text
  ordinal   Int
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                     @default(now())

  @@index([orgId])
  @@index([meetingId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  timestamp Int? // audio timestamp (seconds)
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@index([meetingId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String // "user" | "assistant"
  content   String
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([meetingId])
}

model Export {
  id        String   @id @default(cuid())
  format    String // PDF | DOCX | JSON | CSV | EHR_HL7
  url       String
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([meetingId])
}

model OutputTemplate {
  id             String       @id @default(cuid())
  name           String
  meetingType    String
  promptOverride String
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Tag {
  id       String    @id @default(cuid())
  label    String
  meetings Meeting[]
}

enum Plan {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

enum MeetingStatus {
  UPLOADING
  TRANSCRIBING
  PROCESSING
  COMPLETE
  ERROR
}

model ActionItem {
  id        String       @id @default(cuid())
  task      String
  owner     String?
  dueDate   String?
  priority  String?
  completed Boolean      @default(false)
  meetingId String
  meeting   Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([orgId])
  @@index([meetingId])
  @@index([completed])
}

model ChatAnnotation {
  id         String   @id @default(cuid())
  meetingId  String
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startIndex Int
  endIndex   Int
  startTime  Float?
  content    String
  color      String   @default("yellow")
  createdAt  DateTime @default(now())

  @@index([meetingId])
}

model GlobalChatSession {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title     String?
  messages  GlobalChatMessage[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([userId])
  @@index([orgId])
}

model GlobalChatMessage {
  id        String            @id @default(cuid())
  sessionId String
  session   GlobalChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  citations Json?
  createdAt DateTime          @default(now())

  @@index([sessionId])
}

model ChatUsage {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthYear String
  count     Int      @default(0)
  // Extra messages granted this cycle via purchased $9/100-message packs.
  // Added on top of the plan's monthly allowance; resets with the cycle like `count`.
  bonusMessages Int   @default(0)
  updatedAt DateTime @updatedAt
}

// Idempotency ledger for inbound Stripe webhooks. We record an event id only
// after it has been fully processed; a redelivered event whose id is already
// here is skipped, so a purchased pack can never be credited twice.
model StripeEvent {
  id        String   @id // Stripe event id (evt_...)
  type      String
  createdAt DateTime @default(now())
}

model EmailConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String // "GMAIL" | "OUTLOOK"
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  email        String
  connected    Boolean  @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EmailDigestSettings {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled    Boolean   @default(false)
  sendAt     String    @default("08:00")
  timezone   String    @default("UTC")
  frequency  String    @default("DAILY")
  lastSentAt DateTime?
}

model EmailSend {
  id         String   @id @default(cuid())
  meetingId  String
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId     String
  recipients String[]
  subject    String
  type       String
  sentAt     DateTime @default(now())

  @@index([meetingId])
}

model CalendarConnection {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String // "GOOGLE" | "APPLE"
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  calDavUrl    String?
  calDavUser   String?
  calDavPass   String?   @db.Text
  connected    Boolean   @default(true)
  autoJoin     Boolean   @default(false)
  syncedAt     DateTime?
  createdAt    DateTime  @default(now())
}

model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId  String
  title       String
  startTime   DateTime
  endTime     DateTime
  attendees   String[]
  location    String?
  description String?  @db.Text
  meetingId   String?
  meeting     Meeting? @relation(fields: [meetingId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, externalId])
  @@index([userId])
}

// ===== Competitive Gap Fill (additive) =====

enum BotStatus {
  CREATED
  JOINING
  IN_MEETING
  DONE
  FAILED
}

model MeetingBot {
  id           String    @id @default(cuid())
  recallBotId  String    @unique
  meetingId    String    @unique
  meeting      Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  platform     String
  meetingUrl   String
  status       BotStatus @default(CREATED)
  joinedAt     DateTime?
  leftAt       DateTime?
  recordingUrl String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CRMConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  instanceUrl  String?
  expiresAt    DateTime
  connected    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CRMSync {
  id         String   @id @default(cuid())
  meetingId  String
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId     String
  provider   String
  externalId String
  recordType String
  syncedAt   DateTime @default(now())

  @@index([meetingId])
}

model MeetingAnalytics {
  id                   String   @id @default(cuid())
  meetingId            String   @unique
  meeting              Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  overallEngagement    Float
  participationBalance Float
  questionRate         Float
  decisionRate         Float
  actionRate           Float
  overallSentiment     String
  sentimentByMinute    Json
  speakerStats         Json
  fillerWordCount      Int
  fillerWordDetails    Json
  topicTimeline        Json
  energyTimeline       Json
  insights             Json?
  recommendations      Json?
  generatedAt          DateTime @default(now())
}

model SlackConnection {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String   @db.Text
  teamId      String
  teamName    String
  botUserId   String
  connected   Boolean  @default(true)
  autoPostChannelId String?
  autoPostEnabled   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model NotionConnection {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken   String   @db.Text
  workspaceName String
  workspaceId   String
  connected     Boolean  @default(true)
  parentPageId  String?
  createdAt     DateTime @default(now())
}

model LinearConnection {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken      String   @db.Text
  organizationId   String
  organizationName String
  connected        Boolean  @default(true)
  defaultTeamId    String?
  createdAt        DateTime @default(now())
}

model IntegrationPush {
  id          String   @id @default(cuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId      String
  platform    String
  destination String
  externalUrl String?
  pushedAt    DateTime @default(now())

  @@index([meetingId])
}
