{
  "manifest_version": 3,
  "name": "CLARIX — AI Meeting Notes",
  "version": "0.1.0",
  "description": "Record any meeting tab (Zoom, Meet, Teams) and get AI notes shaped by the meeting type. No bot required.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CLARIX — toggle the overlay (Ctrl/Cmd+Shift+H)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabCapture", "offscreen", "storage", "tabs", "activeTab"],
  "host_permissions": ["https://www.clarixmeetings.com/*", "https://clarixmeetings.com/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.clarixmeetings.com/extension/connect*",
        "https://clarixmeetings.com/extension/connect*"
      ],
      "js": ["content-connect.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-overlay-visibility": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Show / hide the CLARIX overlay (hide it before sharing your screen)"
    },
    "toggle-click-through": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Toggle click-through (let clicks pass through the overlay)"
    }
  }
}
