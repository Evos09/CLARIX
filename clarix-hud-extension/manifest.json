{
  "manifest_version": 3,
  "name": "CLARIX HUD",
  "version": "1.0.0",
  "description": "A floating, glassmorphic AI helper overlay that answers from your CLARIX meeting memory — on any web page.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*.clarixmeetings.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CLARIX HUD — toggle with Ctrl+Shift+H"
  },
  "commands": {
    "toggle-overlay-visibility": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Show / hide the overlay (hide it before sharing your screen)"
    },
    "toggle-click-through": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Toggle click-through (let clicks pass through the overlay)"
    }
  }
}
