<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Merged into the generated Info.plist. macOS terminates an app that
       touches the microphone without a usage description, so the overlay's
       recorder cannot work on macOS without this key. The string is what the
       system permission prompt shows the user, so it has to say plainly what
       we do with the audio. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>CLARIX records audio from your microphone when you start a recording, so it can transcribe the meeting and write your notes.</string>
</dict>
</plist>
