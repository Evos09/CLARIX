<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- bundle.macOS.hardenedRuntime defaults to true. The hardened runtime
       blocks microphone access outright unless this entitlement is granted,
       regardless of the Info.plist usage string, so recording needs both. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
