{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CLARIX",
  "version": "1.0.1",
  "identifier": "ai.clarix.app",
  "build": {},
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CLARIX",
        "url": "https://www.clarixmeetings.com",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": true,
        "decorations": true
      },
      {
        "label": "overlay",
        "title": "CLARIX Overlay",
        "url": "https://www.clarixmeetings.com/overlay",
        "width": 800,
        "height": 600,
        "y": 40,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "AI meeting assistant for every meeting",
    "copyright": "(c) 2026 CLARIX"
  }
}
